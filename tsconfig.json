{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    // ── Strictness ──────────────────────────────────────────────────────────
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    // noUnusedLocals / noUnusedParameters: catch dead code at compile-time.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // noUncheckedIndexedAccess: makes arr[0] return T | undefined instead of
    // T, catching a whole class of index-out-of-bounds crashes at compile
    // time.  Disabled for now because it requires guard updates across
    // Calendar, Notes, and Home pages.  Enable after those are updated.
    "noUncheckedIndexedAccess": false,
    // noPropertyAccessFromIndexSignature: requires bracket notation for
    // index-signature properties (e.g. obj['nombre'] instead of obj.nombre).
    // Disabled pending cleanup of AuthContext index-signature accesses.
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
