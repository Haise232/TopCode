# Copia este archivo como .env.local y rellena los valores reales
# Obtén estos valores en: https://supabase.com/dashboard → tu proyecto → Settings → API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica

# App móvil (packages/mobile) — mismos valores que arriba
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica

# Bot de Telegram (opcional): username del bot sin @. Si falta, se oculta el enlace al bot en Perfil
VITE_TELEGRAM_BOT_USERNAME=tu_bot_sin_arroba
